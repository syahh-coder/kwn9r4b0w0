# COPY TO .env.local — NEVER COMMIT REAL VALUES
# The initial UI starter works without any keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Periksa ketersediaan model/kuota sebelum aktivasi. Tidak ada panggilan saat false.
GEMINI_ANALYSIS_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Admin CRUD memakai JWT/RLS user; worker check memakai key backend di bagian INT-01.
# Optional: third-party fact-check source, subject to provider API policy
# GOOGLE_FACTCHECK_API_KEY=
# Aktifkan hanya setelah Fact Check Tools API, terms, kuota dan biaya proyek diperiksa.
# Terpisah dari Gemini; tidak mengaktifkan Google Search Grounding.
FACTCHECK_SEARCH_ENABLED=false
# Perluasan pencarian/isi sumber meski indeks Fact Check hanya memberi metadata. Bukan Google Grounding.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=false

# Integrasi INT-01. Key backend dan salt hanya di server, jangan NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Alternatif key backend terbaru: SUPABASE_SECRET_KEY=
CHECK_HASH_SECRET=
PUBLIC_CHECK_ENABLED=false
# URL tetap opt-in setelah review SSRF/rate-limit/transport deployment.
PUBLIC_URL_CHECK_ENABLED=false
# Default: bucket bersama untuk klien tak dikenal, tidak percaya X-Forwarded-For.
# Isi hanya bila reverse proxy tepercaya mengganti/menyaring header tersebut.
CHECK_TRUSTED_IP_HEADER=
CHECK_BUDGET_NAMESPACE=public-v1
